<% content_for :title, "Modifier mon compte" %>
<% content_for :hide_tab_bar, true %>
<%= render "shared/page_header", title: "Mon compte", back_path: organization_path %>

<%= form_with model: current_user, url: account_path, method: :patch do |f| %>
  <%= render "shared/form_errors", record: current_user %>

  <div class="mb-3">
    <%= f.label :name, "Prénom et nom *", class: "form-label" %>
    <%= f.text_field :name, autocomplete: "name", class: "form-control form-control-lg" %>
  </div>

  <div class="mb-4">
    <%= f.label :phone, "Téléphone (facultatif)", class: "form-label" %>
    <%= f.telephone_field :phone, autocomplete: "tel", class: "form-control form-control-lg" %>
    <div class="form-text">Visible seulement par la structure avec qui vous avez un échange en cours.</div>
  </div>

  <fieldset class="mb-4">
    <legend class="form-label fs-6">Catégories suivies</legend>
    <div class="form-text mb-2">Les nouvelles annonces de ces catégories vous seront signalées (alertes bientôt disponibles).</div>
    <% followed_ids = current_user.followed_categories.ids %>
    <%= hidden_field_tag "followed_category_ids[]", "" %>
    <% Category.visible.ordered.each do |category| %>
      <div class="form-check">
        <%= check_box_tag "followed_category_ids[]", category.id, followed_ids.include?(category.id),
                          id: "category_#{category.id}", class: "form-check-input" %>
        <%= label_tag "category_#{category.id}", "#{category.icon} #{category.name}", class: "form-check-label" %>
      </div>
    <% end %>
  </fieldset>

  <%= f.submit "Enregistrer", class: "btn btn-primary btn-lg w-100" %>
<% end %>
