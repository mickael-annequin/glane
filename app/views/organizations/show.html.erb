<% content_for :title, "Ma structure" %>
<%= render "shared/page_header", title: "Ma structure", back_path: root_path %>

<section class="info-card">
  <h2>Mon compte</h2>
  <p class="mb-1"><strong><%= current_user.name %></strong></p>
  <p class="mb-1"><%= current_user.email %></p>
  <p class="mb-1"><%= current_user.phone.presence || "Pas de téléphone" %></p>
  <% followed = current_user.followed_categories.count %>
  <% total = Category.visible.count %>
  <p class="mb-3 small text-body-secondary">
    Catégories suivies : <%= followed == total ? "toutes" : "#{followed} sur #{total}" %>
  </p>
  <div class="d-flex flex-wrap gap-2">
    <%= link_to "Modifier mon compte", edit_account_path, class: "btn btn-outline-dark" %>
    <%= link_to "Changer de mot de passe", edit_account_password_path, class: "btn btn-outline-dark" %>
  </div>
</section>

<% if @organization %>
  <section class="info-card">
    <h2>Ma structure</h2>
    <p class="mb-1"><strong><%= @organization.name %></strong></p>
    <p class="mb-1">
      <%= @organization.address %>
      <% if @organization.located? %>
        · <%= link_to "📍 Voir sur une carte", map_url(@organization), target: "_blank", rel: "noopener" %>
      <% end %>
    </p>
    <p class="mb-1"><%= @organization.phone.presence || "Pas de téléphone" %></p>
    <p class="mb-1 small text-body-secondary">Disponibilités habituelles :</p>
    <% lines = availability_lines(@organization.usual_opening_hours, @organization.usual_availability_note) %>
    <% (lines.presence || [ "Pas encore renseignées" ]).each do |line| %>
      <p class="mb-0"><%= line %></p>
    <% end %>
    <div class="mb-3"></div>
    <% if current_user.manager? %>
      <%= link_to "Modifier la structure", edit_organization_path, class: "btn btn-outline-dark" %>
    <% end %>
  </section>
<% end %>

<% if @organization && current_user.manager? %>
  <%= link_to "👥 Membres (#{@organization.active_members.count}) ›", members_path, class: "list-link mb-2" %>
<% end %>
<% if current_user.admin? %>
  <%= link_to "⚙️ Espace admin ›", admin_root_path, class: "list-link mb-2" %>
<% end %>

<%= button_to "Se déconnecter", destroy_user_session_path, method: :delete, class: "btn btn-link text-body-secondary mt-3 px-0" %>
