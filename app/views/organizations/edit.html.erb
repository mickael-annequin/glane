<% content_for :title, "Modifier la structure" %>
<% content_for :hide_tab_bar, true %>
<%= render "shared/page_header", title: "Modifier la structure", back_path: organization_path %>

<%= form_with model: @organization, url: organization_path, method: :patch do |f| %>
  <%= render "shared/form_errors", record: @organization %>

  <div class="mb-3">
    <%= f.label :name, "Nom *", class: "form-label" %>
    <%= f.text_field :name, class: "form-control form-control-lg" %>
  </div>

  <%= render "shared/address_field", f: f, label: "Adresse",
             help: "Elle sera proposée par défaut comme lieu de récupération de vos dons." %>

  <div class="mb-3">
    <%= f.label :phone, "Téléphone de la structure (facultatif)", class: "form-label" %>
    <%= f.telephone_field :phone, class: "form-control form-control-lg" %>
    <div class="form-text">Affiché quand le membre de l'échange n'a pas donné le sien.</div>
  </div>

  <div class="mb-4">
    <%= f.label :usual_availability, "Disponibilités habituelles", class: "form-label" %>
    <%= f.text_area :usual_availability, rows: 3, placeholder: "ex. Du lundi au vendredi, 9h–12h et 14h–17h", class: "form-control form-control-lg" %>
    <div class="form-text">Quand une autre structure peut venir récupérer un don. Recopié dans chaque annonce, et modifiable annonce par annonce.</div>
  </div>

  <%= f.submit "Enregistrer", class: "btn btn-primary btn-lg w-100" %>
<% end %>
