<% if Rails.env.development? %>
  <%# Only on the developer's computer: the local database has test accounts only (db/seeds.rb). %>
  <div class="alert alert-warning small">
    <strong>Version locale (ton ordi).</strong> Comptes de test seulement : <code>admin@glane.test</code>,
    <code>chartres.responsable@glane.test</code>, <code>dreux.membre@glane.test</code>… mot de passe <code>password</code>.
    Ton vrai compte est sur le site en ligne.
  </div>
<% end %>
<div class="login">
  <%= image_tag "logo.svg", width: 88, height: 88, alt: "" %>
  <h1>Glane</h1>
  <p class="login-tagline">Partageons nos surplus<br>pour que rien ne se perde</p>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="mb-3">
      <%= f.label :email, "Email", class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg" %>
    </div>

    <div class="mb-3">
      <%= f.label :password, "Mot de passe", class: "form-label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "form-control form-control-lg" %>
    </div>

    <div class="form-check mb-4">
      <%= f.check_box :remember_me, checked: true, class: "form-check-input" %>
      <%= f.label :remember_me, "Se souvenir de moi", class: "form-check-label" %>
    </div>

    <%= f.submit "Se connecter", class: "btn btn-primary btn-lg w-100" %>
  <% end %>

  <p class="mt-3"><%= link_to "Mot de passe oublié ?", new_user_password_path %></p>

  <p class="login-help">Pas de compte ? Demandez au responsable de votre structure.</p>
</div>
