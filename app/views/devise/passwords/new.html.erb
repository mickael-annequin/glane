<div class="login">
  <%= image_tag "logo.svg", width: 64, height: 64, alt: "" %>
  <h1 class="login-title-small">Mot de passe oublié</h1>
  <p class="login-tagline">Indiquez votre email : vous recevrez un lien pour choisir un nouveau mot de passe.</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="mb-4">
      <%= f.label :email, "Email", class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg" %>
    </div>

    <%= f.submit "Recevoir le lien", class: "btn btn-primary btn-lg w-100" %>
  <% end %>

  <p class="login-help"><%= link_to "← Retour à la connexion", new_user_session_path %></p>
</div>
