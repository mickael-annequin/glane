<%# Temporary home page: the list of listings comes in Phase 2, with the tab bar. %>
<h1 class="text-primary">Glane 🌾</h1>

<% organization = current_user.organization %>
<% if current_user.manager? && organization&.usual_availability.blank? %>
  <div class="todo-box">
    <strong>À FAIRE</strong>
    <p>Complétez la fiche de votre structure : indiquez quand les autres structures peuvent venir récupérer vos dons.</p>
    <%= link_to "Compléter la fiche", edit_organization_path, class: "btn btn-primary" %>
  </div>
<% end %>

<p>
  Bonjour <strong><%= current_user.name %></strong>
  <% if organization %>
    (<%= organization.name %>)
  <% end %>
</p>
<p>Les annonces arrivent bientôt ici.</p>
<%= link_to "🏠 Ma structure", organization_path, class: "btn btn-outline-dark" %>
