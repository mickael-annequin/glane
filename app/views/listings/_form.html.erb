<%# Listing form (docs/conception/wireframes.md, screen 7): the 3 required fields first, then the optional ones. %>
<%= form_with model: listing do |f| %>
  <%= render "shared/form_errors", record: listing %>

  <div class="mb-3">
    <%= f.label :category_id, "Catégorie *", class: "form-label" %>
    <% categories = Category.visible.or(Category.where(id: listing.category_id)).ordered %>
    <%= f.select :category_id, categories.map { |category| [ "#{category.icon} #{category.name}", category.id ] },
                 { include_blank: "Choisir une catégorie" }, class: "form-select form-select-lg" %>
  </div>

  <div class="mb-3">
    <%= f.label :title, "Produit *", class: "form-label" %>
    <%= f.text_field :title, maxlength: 80, placeholder: "ex. Carottes", class: "form-control form-control-lg" %>
  </div>

  <div class="mb-4">
    <%= f.label :available_until, "À récupérer avant le *", class: "form-label" %>
    <%= f.date_field :available_until, min: Date.current, class: "form-control form-control-lg" %>
    <div class="form-text">Ce jour compris. Pour l'alimentaire, avant la date de péremption.</div>
  </div>

  <div class="row g-2 mb-3">
    <div class="col-5">
      <%= f.label :quantity, "Quantité", class: "form-label" %>
      <%= f.text_field :quantity, inputmode: "decimal", placeholder: "ex. 25", class: "form-control form-control-lg",
                       value: listing.quantity&.to_s&.sub(/\.0+\z/, "")&.tr(".", ",") %>
    </div>
    <div class="col-7">
      <%= f.label :unit, "Unité", class: "form-label" %>
      <%= f.select :unit, Listing::UNITS.map { |key, (_singular, plural)| [ plural, key ] },
                   { include_blank: "—" }, class: "form-select form-select-lg" %>
    </div>
  </div>

  <fieldset class="mb-4">
    <legend class="form-label fs-6 mb-2">Conservation</legend>
    <div class="choice-chips">
      <% [ [ "", "Non précisé" ], *Listing::STORAGES.to_a ].each do |value, label| %>
        <%= f.radio_button :storage, value, class: "btn-check", id: "listing_storage_#{value.presence || "none"}",
                           checked: listing.storage.to_s == value %>
        <%= f.label :storage, label, for: "listing_storage_#{value.presence || "none"}", class: "btn btn-outline-dark btn-sm" %>
      <% end %>
    </div>
  </fieldset>

  <%= render "shared/address_field", f: f, label: "Lieu de récupération",
             help: "Par défaut, l'adresse de votre structure." %>

  <%= render "shared/schedule_fields", f: f, attribute: :schedule, schedule: listing.opening_hours, label: "Disponibilités", required: true,
             help: "Quand on peut venir récupérer ce don : la réservation ne proposera que ces horaires. Par défaut, ceux de votre structure." %>

  <div class="mb-3">
    <%= f.label :availability_note, "Précisions (facultatif)", class: "form-label" %>
    <%= f.text_field :availability_note, placeholder: "ex. Sonner à l'entrée du parking", class: "form-control form-control-lg" %>
  </div>

  <div class="mb-4">
    <%= f.label :description, "Informations complémentaires", class: "form-label" %>
    <%= f.text_area :description, rows: 3, placeholder: "ex. À garder au frais, cagettes à rapporter…", class: "form-control form-control-lg" %>
  </div>

  <%# Optional and discreet: for a common product, the category icon is enough. %>
  <fieldset class="mb-4" data-controller="photo-preview">
    <legend class="form-label fs-6 mb-1">Photos (facultatif)</legend>
    <div class="form-text mb-2">Seulement si c'est utile, par exemple pour montrer l'état du stock. <%= Listing::MAX_PHOTOS %> au maximum.</div>
    <% saved_photos = listing.photos.attachments.select { |photo| photo.blob.persisted? } %>
    <% if saved_photos.any? %>
      <div class="photo-thumbs mb-2">
        <% saved_photos.each do |photo| %>
          <label class="photo-thumb">
            <%= image_tag photo_url(photo, width: 160, height: 160, crop: :fill, gravity: :auto), alt: "" %>
            <%# Checked = kept. Unchecking a photo removes it when saving. %>
            <span class="form-check">
              <%= check_box_tag "listing[photos][]", photo.signed_id, true, id: "keep_photo_#{photo.id}", class: "form-check-input" %>
              <span class="form-check-label small">Garder</span>
            </span>
          </label>
        <% end %>
      </div>
    <% end %>
    <%# Two ways to add photos: the camera (capture) or the gallery. They are gathered by photo_preview_controller.js
        in the hidden field below, the one actually sent. %>
    <div class="d-flex gap-2">
      <label class="btn btn-outline-dark flex-fill">
        📷 Prendre une photo
        <input type="file" accept="image/*" capture="environment" hidden data-action="change->photo-preview#add">
      </label>
      <label class="btn btn-outline-dark flex-fill">
        🖼️ Galerie
        <input type="file" accept="image/*" multiple hidden data-action="change->photo-preview#add">
      </label>
    </div>
    <%= f.file_field :photos, multiple: true, accept: "image/*", hidden: true, data: { photo_preview_target: "input" } %>
    <div class="photo-thumbs mt-2" data-photo-preview-target="list"></div>
  </fieldset>

  <%= f.submit listing.new_record? ? "Publier" : "Enregistrer", class: "btn btn-primary btn-lg w-100" %>
  <p class="form-text text-center mt-2">* obligatoire</p>
<% end %>
