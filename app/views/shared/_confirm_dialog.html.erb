<%# The confirmation window of the app (app/javascript/controllers/confirm_dialog_controller.js). %>
<dialog class="confirm-dialog" data-controller="confirm-dialog">
  <form method="dialog">
    <p class="confirm-dialog-message" data-confirm-dialog-target="message"></p>
    <div class="confirm-dialog-buttons">
      <button value="no" class="btn btn-outline-dark btn-lg">Non</button>
      <button value="yes" class="btn btn-primary btn-lg">Oui</button>
    </div>
  </form>
</dialog>
