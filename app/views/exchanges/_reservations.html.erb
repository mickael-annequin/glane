<%# "Réservations" tab: what my structure reserved. The next pickup first, then the history. %>
<% if @current_reservations.empty? && @past_reservations.empty? %>
  <p class="text-center text-body-secondary mt-4">Aucune réservation pour l'instant.</p>
  <%= link_to "Voir les annonces", root_path, class: "btn btn-primary btn-lg w-100" %>
<% else %>
  <h2 class="exchange-section">En cours</h2>
  <% if @current_reservations.empty? %>
    <p class="text-body-secondary">Aucune réservation en cours. <%= link_to "Voir les annonces", root_path %></p>
  <% else %>
    <div class="exchange-list">
      <% @current_reservations.each do |reservation| %>
        <% listing = reservation.listing %>
        <%= link_to listing_path(listing), class: "exchange-row" do %>
          <span class="exchange-icon"><%= listing.category.icon %></span>
          <span class="flex-fill">
            <strong><%= listing.title %></strong><%= " · #{listing.quantity_label}" if listing.quantity_label %>
            <span class="d-block small">
              <span class="badge text-bg-warning">Passage <%= pickup_label(reservation.pickup_at) %></span>
            </span>
            <span class="d-block small text-body-secondary"><%= listing.organization.name %> · <%= listing.city %> · réservée par <%= reservation.user.name %></span>
          </span>
          <span aria-hidden="true">›</span>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @past_reservations.any? %>
    <h2 class="exchange-section">Historique</h2>
    <div class="exchange-list exchange-list-past">
      <% @past_reservations.each do |reservation| %>
        <% listing = reservation.listing %>
        <div class="exchange-row">
          <span class="exchange-icon"><%= listing.category.icon %></span>
          <span class="flex-fill">
            <strong><%= listing.title %></strong><%= " · #{listing.quantity_label}" if listing.quantity_label %>
            <span class="d-block small"><%= reservation_status(reservation) %> · <%= listing.organization.name %></span>
          </span>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
